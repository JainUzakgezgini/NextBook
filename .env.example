# Copy this file to .env and fill in your own values.
# Never commit the real .env file to GitHub.
SECRET_KEY=change-me-to-a-long-random-string
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_BOOKS_API_KEY=your-google-books-api-key-here

# Gemini model to use first (see DEVLOG.md for why this one)
GEMINI_MODEL=gemini-3.6-flash

# E-mail for "Forgot password" (Gmail: use an App Password, not your normal password)
# Without these, the reset link is printed in the terminal when running locally.
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-16-character-app-password

# Only on the live server:
# COOKIE_SECURE=1
# BEHIND_PROXY=1
# APP_BASE_URL=https://nextbook.duckdns.org
